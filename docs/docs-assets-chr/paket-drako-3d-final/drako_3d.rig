  "clips_standard": [
    {
      "clip": "idle_fresh",
      "type": "Looping, base",
      "trigger": "HP > 60",
      "description": "Napas dada, kepala menoleh, sayap kiri/kanan berlawanan fase, ekor berurutan 1-2-3-Tip, kaki melangkah kecil"
    },
    {
      "clip": "idle_tired",
      "type": "Looping, base",
      "trigger": "HP 30-60",
      "description": "Membungkuk, kepala menunduk, sayap terkulai, ekor terkulai, napas lambat berat"
    },
    {
      "clip": "idle_critical",
      "type": "Looping, base",
      "trigger": "HP < 30",
      "description": "Gemetar halus frekuensi tinggi, sayap merapat, ekor bergetar, postur meringkuk"
    },
    {
      "clip": "sleep",
      "type": "Looping",
      "trigger": "isResting true, mengalahkan semua idle",
      "description": "Meringkuk, kepala menunduk, sayap menutupi badan seperti selimut, ekor memeluk tubuh, napas sangat lambat"
    },
    {
      "clip": "tap_reaction",
      "type": "One-Shot 0.8 detik",
      "trigger": "Layar disentuh",
      "description": "Lompat kecil, kepala miring ke kamera, sayap mengepak gembira, ekor mengibas, lalu kembali ke idle"
    },
    {
      "clip": "celebrate",
      "type": "One-Shot 1.8 detik",
      "trigger": "Misi selesai atau naik level",
      "description": "Root berputar 360 derajat, lompat, sayap mengepak besar, ekor mengayun besar, kepala mendongak"
    }
  ],
  "idle_auto_cycle": {
    "rule": "Jangan putar satu idle berulang terus. Controller memilih satu varian secara acak, memutarnya sekali, menunggu jeda acak 0.5-2.0 detik, lalu memilih varian lain yang berbeda dari varian sebelumnya, selama state HP/isResting tidak berubah. Sentuhan, celebrate, atau perubahan state langsung memotong siklus dan kembali ke idle yang sesuai setelah one-shot selesai.",
    "idle_fresh_variants": [
      "idle_fresh",
      "idle_fresh_a breathing",
      "idle_fresh_b look around",
      "idle_fresh_c wing flutter",
      "idle_fresh_d tail wag and head tilt"
    ],
    "idle_tired_variants": [
      "idle_tired",
      "idle_tired_a heavy breath",
      "idle_tired_b head droop and wing droop",
      "idle_tired_c tail drag"
    ],
    "idle_critical_variants": [
