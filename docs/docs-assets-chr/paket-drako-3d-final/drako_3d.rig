  "how_to_move_one_part_alone": {
    "three_js_wing": "gltf.scene.getObjectByName('Wing_L').rotation.z += 0.35; // hanya sayap kiri, sayap kanan diam",
    "three_js_wing_tip": "gltf.scene.getObjectByName('Wing_L_Tip').rotation.z += 0.35;",
    "three_js_tail": "gltf.scene.getObjectByName('Tail_3').rotation.y += 0.35; // hanya ekor tengah-ujung, badan diam",
    "three_js_head": "gltf.scene.getObjectByName('Head').rotation.y += 0.25;",
    "unity_wing": "transform.Find('Root/Hips/Spine/Chest/Wing_L')",
    "unity_tail": "transform.Find('Root/Hips/Tail_1/Tail_2/Tail_3')",
    "note": "Di model_viewer_plus, hanya klip penuh yang bisa dipilih, bukan joint tunggal. Kontrol joint tunggal butuh Three.js/WebGL, Unity, atau Godot dengan nama joint di atas."
  },
